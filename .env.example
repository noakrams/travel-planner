# Public browser endpoints only. The app uses a local adapter when these are blank.
VITE_NEON_AUTH_URL=
VITE_NEON_DATA_API_URL=

# Public browser key. Restrict it to the production and local-development domains in MapTiler Cloud.
VITE_MAPTILER_API_KEY=

# Never add service-role keys, database passwords, Management API tokens, or GitHub credentials.
